# Copie para .env e ajuste. O .env não vai para o Git.

# Senha do Postgres — o docker-compose falha de propósito se estiver vazia.
DB_PASSWORD=troque-esta-senha

# Senha de acesso ao app (uma só; não há cadastro de usuário). Deixar vazia mantém o
# app aberto para quem alcançar a URL — a interface mostra uma faixa avisando disso.
AUTH_SENHA=

# Assina o cookie de sessão e deriva o token do atalho de importação. Gere um valor
# aleatório longo:  openssl rand -hex 32
# Trocar este valor desloga todas as sessões e invalida os atalhos já instalados no
# navegador — é exatamente assim que se revoga um atalho vazado.
SECRET_KEY=troque-por-um-valor-aleatorio-longo

# Só necessário para rodar o backend fora do Compose (dev local):
# DATABASE_URL=postgresql+asyncpg://financas:troque-esta-senha@localhost:5432/financas
# AMBIENTE=development
